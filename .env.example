# Copy to .env; use uv run --env-file .env ... (the package does not auto-load it).
# OpenRouter is the primary provider; set one real key for the selected provider.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# No credentials, cookies, private browser profile paths, or traces belong in Git.
# Optional provider overrides; defaults are provider-specific Luna Decisions.
# BROWSER_AGENT_MODEL=openai/gpt-6-luna-decisions
# BROWSER_AGENT_VISION=true
# BROWSER_AGENT_TIMEOUT=30
# Field text uses a separate structured-output chat request (paid).
# BROWSER_AGENT_TEXT_PROVIDER=openrouter
# BROWSER_AGENT_TEXT_MODEL=openai/gpt-4.1-mini
# Advanced endpoints must preserve the provider's actual wire schema.
# BROWSER_AGENT_DECISIONS_ENDPOINT=https://openrouter.ai/api/alpha/decisions
# BROWSER_AGENT_TEXT_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
# Native profile attachment is opt-in host policy, not a model tool argument.
# Enable only after reviewing CDP access and opting in inside running Chrome:
# BROWSER_NATIVE_CONSENT=1
# BROWSER_NATIVE_PROFILE_DIRECTORY=/absolute/user-data-directory
# File operations remain disabled without trusted host path/approval policy.
# BROWSER_FILES_DIRECTORY=/absolute/approved-files-directory
# BROWSER_APPROVALS_FILE=/absolute/private-approval-records.json
# Optional trusted host Chromium/Chrome executable for explicit isolated launch.
# BROWSER_EXECUTABLE_PATH=/absolute/path/to/chrome
